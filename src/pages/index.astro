---
import Base from '../layouts/Base.astro';
import { algorithms } from '../lib/registry';

const base = import.meta.env.BASE_URL;

const ICONS: Record<string, string> = {
  'bubble-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="6" cy="17" r="2.5"/><circle cx="12" cy="11" r="3.5"/><circle cx="18" cy="4.5" r="2"/></svg>',
  'selection-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20v-6M9 20V7M14 20v-9M19 20V4"/><circle cx="9" cy="4" r="2"/></svg>',
  'insertion-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20v-6M9 20V9M19 20V5"/><path d="M14 3v8m0 0-3-3m3 3 3-3"/></svg>',
  'merge-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v5l6 5 6-5V4M12 14v6"/></svg>',
  'quick-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20v-7M9 20V6M14 20v-4M19 20v-9"/><circle cx="9" cy="3.5" r="1.5" fill="currentColor" stroke="none"/></svg>',
  'linear-search':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10" cy="10" r="6"/><path d="M15 15l6 6M7 10h6"/></svg>',
  'binary-search':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10" cy="10" r="6"/><path d="M15 15l6 6M10 7v6"/></svg>',
  raid:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>',
  flexbox:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="8" width="5" height="8" rx="1"/><rect x="10.5" y="6" width="4" height="12" rx="1"/><rect x="17" y="9" width="4" height="6" rx="1"/></svg>',
  grid:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 12h16M12 4v16"/></svg>',
};

interface Card {
  href: string;
  title: string;
  desc: string;
  badge: string;
  icon: string;
  tint: string;
}

const algoCard = (a: (typeof algorithms)[number], tint: string): Card => ({
  href: `${base}viz/${a.slug}/`,
  title: a.title,
  desc: a.description,
  badge: `avg ${a.complexity.average}`,
  icon: ICONS[a.slug]!,
  tint,
});

const sections: { name: string; cards: Card[] }[] = [
  {
    name: 'Sorting',
    cards: algorithms
      .filter((a) => a.category === 'sorting')
      .map((a) => algoCard(a, '#5b8dee')),
  },
  {
    name: 'Searching',
    cards: algorithms
      .filter((a) => a.category === 'searching')
      .map((a) => algoCard(a, '#f2b134')),
  },
  {
    name: 'Systems',
    cards: [
      {
        href: `${base}viz/raid/`,
        title: 'RAID Levels',
        desc: 'How RAID 0, 1, 5, 6, and 10 lay data, mirrors, and parity across disks — and what happens when drives fail.',
        badge: 'interactive',
        icon: ICONS.raid!,
        tint: '#9b5de5',
      },
    ],
  },
  {
    name: 'CSS Layout',
    cards: [
      {
        href: `${base}viz/flexbox/`,
        title: 'Flexbox Playground',
        desc: 'Toggle direction, justification, alignment, wrap, and gap on a live flex container; give items their own grow and align-self.',
        badge: 'playground',
        icon: ICONS.flexbox!,
        tint: '#3ddc84',
      },
      {
        href: `${base}viz/grid/`,
        title: 'Grid Playground',
        desc: 'Shape a live CSS grid — track counts, gaps, item alignment, and column/row spans — with the generated CSS alongside.',
        badge: 'playground',
        icon: ICONS.grid!,
        tint: '#3ddc84',
      },
    ],
  },
];
---

<Base title="Interactive Algorithms">
  <h1>Algorithm Visualizations</h1>
  <p class="desc">
    Interactive, step-by-step visualizations of classic algorithms and systems concepts. Pick one,
    press Play, and watch it work — or single-step through every comparison and swap.
  </p>

  {
    sections.map((section) => (
      <>
        <h2>{section.name}</h2>
        <div class="card-grid">
          {section.cards.map((c) => (
            <a class="card" href={c.href} style={`--tint: ${c.tint}`}>
              <span class="card-icon" set:html={c.icon} />
              <span class="card-body">
                <h3>{c.title}</h3>
                <p>{c.desc}</p>
                <span class="badge">{c.badge}</span>
              </span>
            </a>
          ))}
        </div>
      </>
    ))
  }
</Base>
