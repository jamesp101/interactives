---
import Base from '../layouts/Base.astro';
import { algorithms } from '../lib/registry';

const base = import.meta.env.BASE_URL;

const ICONS: Record<string, string> = {
  'bubble-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="6" cy="17" r="2.5"/><circle cx="12" cy="11" r="3.5"/><circle cx="18" cy="4.5" r="2"/></svg>',
  'selection-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20v-6M9 20V7M14 20v-9M19 20V4"/><circle cx="9" cy="4" r="2"/></svg>',
  'insertion-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20v-6M9 20V9M19 20V5"/><path d="M14 3v8m0 0-3-3m3 3 3-3"/></svg>',
  'merge-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v5l6 5 6-5V4M12 14v6"/></svg>',
  'quick-sort':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20v-7M9 20V6M14 20v-4M19 20v-9"/><circle cx="9" cy="3.5" r="1.5" fill="currentColor" stroke="none"/></svg>',
  'linear-search':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10" cy="10" r="6"/><path d="M15 15l6 6M7 10h6"/></svg>',
  'binary-search':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10" cy="10" r="6"/><path d="M15 15l6 6M10 7v6"/></svg>',
  raid:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>',
  flexbox:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="8" width="5" height="8" rx="1"/><rect x="10.5" y="6" width="4" height="12" rx="1"/><rect x="17" y="9" width="4" height="6" rx="1"/></svg>',
  grid:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 12h16M12 4v16"/></svg>',
  hooks:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/><ellipse cx="12" cy="12" rx="9.5" ry="3.8"/><ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(120 12 12)"/></svg>',
  filesystem:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h5l2 2.5h9v13H4z"/><path d="M4 11h16"/></svg>',
  structAlignment:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2.5" y="9" width="4" height="6" rx="1"/><path d="M8.5 9v6" stroke-dasharray="2 2"/><rect x="10.5" y="9" width="4" height="6" rx="1"/><path d="M16.5 9v6" stroke-dasharray="2 2"/><rect x="18.5" y="9" width="3" height="6" rx="1"/></svg>',
  cache:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M9 3v3M15 3v3M9 18v3M15 18v3"/></svg>',
  dod:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M9 4v5M15 4v5"/><rect x="3" y="15" width="18" height="5" rx="1"/></svg>',
  pointers:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="8" width="6" height="8" rx="1"/><rect x="15.5" y="8" width="6" height="8" rx="1"/><path d="M9.5 12h4.5m0 0-2-2m2 2-2 2"/></svg>',
  stackHeap:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="3" rx="1"/><rect x="4" y="7.5" width="16" height="3" rx="1"/><path d="M12 13v3" stroke-dasharray="2 2"/><rect x="4" y="18" width="16" height="3" rx="1"/></svg>',
  allocators:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2.5" y="8" width="19" height="8" rx="2"/><path d="M8 8v8M13 8v8M17 8v8"/></svg>',
};

interface Card {
  href: string;
  title: string;
  desc: string;
  kind: string;
  metas: string[];
  icon: string;
  tint: string;
}

const algoCard = (a: (typeof algorithms)[number], tint: string): Card => ({
  href: `${base}viz/${a.slug}/`,
  title: a.title,
  desc: a.description,
  kind: a.category,
  metas: [`avg ${a.complexity.average}`, `space ${a.complexity.space}`],
  icon: ICONS[a.slug]!,
  tint,
});

const sections: { name: string; cards: Card[] }[] = [
  {
    name: 'Sorting',
    cards: algorithms
      .filter((a) => a.category === 'sorting')
      .map((a) => algoCard(a, '#5b8dee')),
  },
  {
    name: 'Searching',
    cards: algorithms
      .filter((a) => a.category === 'searching')
      .map((a) => algoCard(a, '#f2b134')),
  },
  {
    name: 'Systems',
    cards: [
      {
        href: `${base}viz/raid/`,
        title: 'RAID Levels',
        desc: 'How RAID 0, 1, 5, 6, and 10 lay data, mirrors, and parity across disks — and what happens when drives fail.',
        kind: 'storage',
        metas: ['5 levels', 'failure sim'],
        icon: ICONS.raid!,
        tint: '#9b5de5',
      },
      {
        href: `${base}viz/filesystem/`,
        title: 'Linux Filesystem Hierarchy',
        desc: 'What lives in /usr, /var, /etc, and the rest of the FHS tree — browsable, searchable, and classified by static vs. variable and shareable vs. unshareable.',
        kind: 'filesystem',
        metas: ['FHS 3.0', '39 directories'],
        icon: ICONS.filesystem!,
        tint: '#9b5de5',
      },
    ],
  },
  {
    name: 'CSS Layout',
    cards: [
      {
        href: `${base}viz/flexbox/`,
        title: 'Flexbox Playground',
        desc: 'Toggle direction, justification, alignment, wrap, and gap on a live flex container; give items their own grow and align-self.',
        kind: 'playground',
        metas: ['7 properties'],
        icon: ICONS.flexbox!,
        tint: '#3ddc84',
      },
      {
        href: `${base}viz/grid/`,
        title: 'Grid Playground',
        desc: 'Shape a live CSS grid — track counts, gaps, item alignment, and column/row spans — with the generated CSS alongside.',
        kind: 'playground',
        metas: ['6 properties'],
        icon: ICONS.grid!,
        tint: '#3ddc84',
      },
    ],
  },
  {
    name: 'React',
    cards: [
      {
        href: `${base}viz/hooks/`,
        title: 'React Hooks',
        desc: 'How useState, useEffect, useRef, and useMemo really work: hook slots, re-renders, dependency arrays, and cleanups in a live simulated runtime.',
        kind: 'runtime',
        metas: ['4 hooks', 'slot inspector'],
        icon: ICONS.hooks!,
        tint: '#61dafb',
      },
    ],
  },
  {
    name: 'Memory & Performance',
    cards: [
      {
        href: `${base}viz/struct-alignment/`,
        title: 'Struct Alignment & Padding',
        desc: 'Why a struct of a char, a double, a char, and an int costs 24 bytes instead of 14 — and how reordering fields wins it back.',
        kind: 'abi',
        metas: ['x86-64 SysV', '8 types'],
        icon: ICONS.structAlignment!,
        tint: '#e4572e',
      },
      {
        href: `${base}viz/cache/`,
        title: 'Cache Hits & Misses',
        desc: 'Step a configurable set-associative cache through access patterns and watch lines fill, hit, and get evicted.',
        kind: 'performance',
        metas: ['64 B lines', '5 patterns'],
        icon: ICONS.cache!,
        tint: '#e4572e',
      },
      {
        href: `${base}viz/data-oriented-design/`,
        title: 'Data-Oriented Design',
        desc: 'Array of structs vs struct of arrays, measured: which cache lines each layout drags in, and how many of those bytes you actually use.',
        kind: 'performance',
        metas: ['AoS vs SoA', '3 workloads'],
        icon: ICONS.dod!,
        tint: '#e4572e',
      },
      {
        href: `${base}viz/pointers/`,
        title: 'Pointers',
        desc: 'Step through addresses, dereferences, scaled pointer arithmetic, pointer-to-pointer, and the null and dangling cases that crash.',
        kind: 'language',
        metas: ['11 steps', 'use-after-free'],
        icon: ICONS.pointers!,
        tint: '#e4572e',
      },
      {
        href: `${base}viz/stack-heap/`,
        title: 'Stack & Heap',
        desc: 'Push and pop call frames against a deliberately tiny stack while heap blocks are allocated, freed, leaked, and overflowed.',
        kind: 'runtime',
        metas: ['1 KB stack', 'leaks & overflow'],
        icon: ICONS.stackHeap!,
        tint: '#e4572e',
      },
      {
        href: `${base}viz/allocators/`,
        title: 'Memory Allocators',
        desc: 'Bump, free list, pool, and stack allocators on one 512-byte arena — including the fragmentation each one does or does not suffer.',
        kind: 'runtime',
        metas: ['4 strategies', '512 B arena'],
        icon: ICONS.allocators!,
        tint: '#e4572e',
      },
    ],
  },
];
---

<Base title="Interactive Algorithms">
  <h1>Algorithm Visualizations</h1>
  <p class="desc">
    Interactive, step-by-step visualizations of classic algorithms and systems concepts. Pick one,
    press Play, and watch it work — or single-step through every comparison and swap.
  </p>

  {
    sections.map((section) => (
      <>
        <div class="section-head">
          <h2>{section.name}</h2>
          <span class="section-count">{section.cards.length}</span>
        </div>
        <ul class="card-grid">
          {section.cards.map((c) => (
            <li>
              <a class="card" href={c.href} style={`--tint: ${c.tint}`}>
                <span class="card-head">
                  <span class="card-icon" set:html={c.icon} />
                  <h3>{c.title}</h3>
                </span>
                <p>{c.desc}</p>
                <span class="card-foot">
                  <span class="card-metas">
                    <span class="meta kind">{c.kind}</span>
                    {c.metas.map((m) => (
                      <span class="meta">{m}</span>
                    ))}
                  </span>
                  <svg
                    class="card-go"
                    aria-hidden="true"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Base>
